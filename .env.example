# Copia este fichero como .env.local y rellena los valores (ver README).
# Supabase → Project Settings → API / API Keys.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clave PÚBLICA: "publishable" (sb_publishable_...) o la "anon" antigua.
# NUNCA pongas aquí la clave secret / service_role.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Notificaciones (fase 4): la clave PÚBLICA VAPID. La privada solo va en los secretos de Supabase.
VITE_VAPID_PUBLIC_KEY=
